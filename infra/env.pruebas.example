# Staging (pruebas.): copie como .env.pruebas en el servidor (permisos 600). Comparte el servidor con
# producción: otro proyecto de Compose (su propia base y volúmenes), otro puerto y menos memoria.
# Use claves distintas a las de producción.
SAPEF_PROYECTO=sapef-pruebas
# Registro de las imágenes que publica la CI (sapef-backend y sapef-estaticos).
SAPEF_REGISTRO=ghcr.io/<cuenta>
# Lo actualiza infra/desplegar.sh en cada despliegue; no se edita a mano.
SAPEF_IMAGEN=ghcr.io/<cuenta>/sapef-backend:<version>
# Carpeta de la instalación: estáticos por versión (estaticos/actual/{web,campo}) y registro de versiones.
SAPEF_DESPLIEGUE_DIR=/srv/sapef-pruebas
SAPEF_ENTORNO=pruebas
SAPEF_PUERTO_API=8101

POSTGRES_DB=sapef
POSTGRES_USER=sapef
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48   (la API no arranca en producción con una clave débil)
SAPEF_SECRET_KEY=

# Correo (recuperación de contraseña y avisos de PQRS)
SAPEF_SMTP_HOST=
SAPEF_SMTP_PUERTO=587
SAPEF_SMTP_USUARIO=
SAPEF_SMTP_CLAVE=
SAPEF_SMTP_REMITENTE=noreply@sapef.co

# Web Push de la app de campo: docker compose ... run --rm migraciones python -m app.semillas vapid
SAPEF_VAPID_CLAVE_PRIVADA=
SAPEF_VAPID_SUJETO=mailto:soporte@sapef.co

# Carpeta del servidor con los paquetes de OPainn (se monta en solo lectura)
SAPEF_IMPORTACION_HOST_DIR=/srv/sapef-pruebas/importacion

# Límites de memoria (el servidor es compartido con otros dos sistemas)
SAPEF_MEM_DB=512m
SAPEF_MEM_API=512m
SAPEF_MEM_WORKER=1g
SAPEF_API_WORKERS=1
