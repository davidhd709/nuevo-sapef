# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Entorno: desarrollo | pruebas | produccion
SAPEF_ENTORNO=desarrollo

# Base de datos (en desarrollo la levanta infra/docker-compose.dev.yml)
POSTGRES_DB=sapef
POSTGRES_USER=sapef
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_PUERTO_LOCAL=55432

# URL que usa la API. Dentro de Docker el host es "db"; fuera, 127.0.0.1:55432 (no "localhost": en Windows intenta IPv6 y se cuelga)
SAPEF_DATABASE_URL=postgresql+psycopg://sapef:cambiar-en-local@127.0.0.1:55432/sapef

# Nivel de logs: DEBUG | INFO | WARNING
SAPEF_LOG_NIVEL=INFO

# Seguridad y sesiones (obligatorio cambiar por >= 32 caracteres aleatorios en produccion)
SAPEF_SECRET_KEY=dev-solo-local-no-usar-en-produccion-32bytes
# Dejar vacio para automatico (true en produccion, false en desarrollo/pruebas)
# SAPEF_COOKIE_SEGURA=false
SAPEF_SESION_ACCESO_MINUTOS=15
SAPEF_SESION_RENOVACION_WEB_HORAS=12
SAPEF_SESION_RENOVACION_PWA_DIAS=30
SAPEF_LOGIN_MAX_INTENTOS=5
SAPEF_LOGIN_BLOQUEO_MINUTOS=15
SAPEF_RECUPERACION_TOKEN_MINUTOS=30

# Almacenamiento de archivos y evidencias
SAPEF_ARCHIVOS_DIR=/data/archivos
SAPEF_ARCHIVOS_BACKEND=local
SAPEF_ARCHIVO_MAX_EVIDENCIA_MB=10
SAPEF_ARCHIVO_MAX_GENERAL_MB=256

# Contraseña del primer administrador para `python -m app.semillas admin` (si falta, se pide por
# consola). Úsela solo en el momento de crearlo y luego bórrela de .env.
# SAPEF_ADMIN_CLAVE=

# SMTP opcional (solo variables de entorno, nunca en BD)
# SAPEF_SMTP_HOST=
# SAPEF_SMTP_PUERTO=587
# SAPEF_SMTP_USUARIO=
# SAPEF_SMTP_CLAVE=
# SAPEF_SMTP_REMITENTE=noreply@sapef.co
# SAPEF_SMTP_TLS=true

# Web Push de la app de campo (avisos de órdenes asignadas). Generar con
#   cd backend && python -m app.semillas vapid
# Sin clave, la API acepta suscripciones pero no envía avisos.
# SAPEF_VAPID_CLAVE_PRIVADA=
# SAPEF_VAPID_SUJETO=mailto:soporte@sapef.co
